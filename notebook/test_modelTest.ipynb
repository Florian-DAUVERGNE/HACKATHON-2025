import pytest
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM

# File: notebook/test_modelTest.py


# Constants
MODEL_NAME = "t5-large"
INPUT_TEXT = """
Perturbations en cours : De 2025-03-27 18:42:00 à 2025-04-22 04:30:00, 
l'événement avec l'ID 26847bb8-0b33-11f0-b7af-0a58a9feac02 (dernière mise à jour le 20250327T184436) est causé par TRAVAUX. La sévérité est bloquante. 
Les balises associées sont Actualité. Le titre de l'événement est : Tramway T1 : Travaux - Trafic interrompu. Message : Jusqu'au lundi 21 avril 2025, le trafic est interrompu entre Gare de Noisy-le-Sec et Escadrille Normandie-Niémen en raison de travaux. 
Bus de remplacement. Plus d'informations sur le site ratp.fr. Message court : Trafic interrompu. Points d'arrêt affectés : Auguste Delaune, Bobigny - Pablo Picasso, Escadrille Normandie-Niemen, Gare de Noisy-le-Sec, Hôtel de Ville de Bobigny, Jean Rostand, La Ferme, 
Libération, Petit Noisy, Pont de Bondy. Nom : T1. Mode : Tramway. Statut : now. Priorité : 0.0. Effet : NO_SERVICE. Texte : Jusqu'au lundi 21 avril 2025, le trafic est interrompu entre Gare de Noisy-le-Sec et Escadrille Normandie-Niémen en raison de travaux.
"""

@pytest.fixture
def load_model_and_tokenizer():
    """Fixture to load the model and tokenizer."""
    tokenizer = AutoTokenizer.from_pretrained(MODEL_NAME)
    model = AutoModelForSeq2SeqLM.from_pretrained(MODEL_NAME)
    return tokenizer, model

def test_model_initialization(load_model_and_tokenizer):
    """Test if the model and tokenizer are loaded correctly."""
    tokenizer, model = load_model_and_tokenizer
    assert tokenizer is not None, "Tokenizer failed to load."
    assert model is not None, "Model failed to load."

def test_input_preparation(load_model_and_tokenizer):
    """Test if the input text is tokenized correctly."""
    tokenizer, _ = load_model_and_tokenizer
    input_ids = tokenizer.encode("Résume ce texte en un contenu structuré et concis : " + INPUT_TEXT, return_tensors="pt", max_length=3000, truncation=True)
    assert input_ids.shape[1] <= 3000, "Input exceeds maximum length."
    assert input_ids is not None, "Input tokenization failed."

def test_output_generation(load_model_and_tokenizer):
    """Test if the model generates an output without errors."""
    tokenizer, model = load_model_and_tokenizer
    input_ids = tokenizer.encode("Résume ce texte en un contenu structuré et concis : " + INPUT_TEXT, return_tensors="pt", max_length=3000, truncation=True)
    outputs = model.generate(input_ids, max_length=1500, num_beams=4, early_stopping=True)
    assert outputs is not None, "Model failed to generate output."
    summary = tokenizer.decode(outputs[0], skip_special_tokens=True)
    assert summary, "Generated summary is empty."

def test_summary_quality(load_model_and_tokenizer):
    """Test the quality of the generated summary."""
    tokenizer, model = load_model_and_tokenizer
    input_ids = tokenizer.encode("Résume ce texte en un contenu structuré et concis : " + INPUT_TEXT, return_tensors="pt", max_length=3000, truncation=True)
    outputs = model.generate(input_ids, max_length=1500, num_beams=4, early_stopping=True)
    summary = tokenizer.decode(outputs[0], skip_special_tokens=True)
    assert "Bus de remplacement" in summary, "Key phrase 'Bus de remplacement' missing in summary."
    assert "Trafic interrompu" in summary, "Key phrase 'Trafic interrompu' missing in summary."
    assert summary.count("Bus de remplacement") == 1, "Summary contains repeated phrases."

def test_empty_input(load_model_and_tokenizer):
    """Test the model with an empty input."""
    tokenizer, model = load_model_and_tokenizer
    input_ids = tokenizer.encode("Résume ce texte en un contenu structuré et concis : ", return_tensors="pt", max_length=3000, truncation=True)
    outputs = model.generate(input_ids, max_length=1500, num_beams=4, early_stopping=True)
    summary = tokenizer.decode(outputs[0], skip_special_tokens=True)
    assert summary, "Model failed to handle empty input."

def test_long_input(load_model_and_tokenizer):
    """Test the model with a very long input."""
    tokenizer, model = load_model_and_tokenizer
    long_text = INPUT_TEXT * 10  # Repeat the input text to make it very long
    input_ids = tokenizer.encode("Résume ce texte en un contenu structuré et concis : " + long_text, return_tensors="pt", max_length=3000, truncation=True)
    outputs = model.generate(input_ids, max_length=1500, num_beams=4, early_stopping=True)
    summary = tokenizer.decode(outputs[0], skip_special_tokens=True)
    assert summary, "Model failed to handle long input."